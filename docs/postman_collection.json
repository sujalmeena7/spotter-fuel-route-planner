          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/autocomplete/?q=dal",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "autocomplete", ""],
          "query": [
            {
              "key": "q",
              "value": "dal"
            }
          ]
        },
        "description": "Fast offline autocomplete matching US cities with 0 external API calls."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns list of suggestions', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.suggestions).to.be.an('array');",
              "    pm.expect(json.suggestions.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Error Case — 400 Invalid Input (Missing Finish)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/?start=Dallas,TX",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "route-plan", ""],
          "query": [
            {
              "key": "start",
              "value": "Dallas,TX"
            }
          ]
        },
        "description": "Validation error when finish parameter is missing."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Error code is INVALID_INPUT', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.error.code).to.eql('invalid_input');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Error Case — 422 Location Not Found",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/route-plan/?start=Nonexistentcityxyz9999&finish=Denver,CO",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "route-plan", ""],
          "query": [
            {
              "key": "start",
              "value": "Nonexistentcityxyz9999"
            },
            {
              "key": "finish",
              "value": "Denver,CO"
            }
          ]
        },
        "description": "Unprocessable entity when location cannot be resolved."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422', function () {",
              "    pm.response.to.have.status(422);",
              "});",
