# Spotter Fuel Optimizer - Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-secure-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# OpenRouteService API Key (Free tier at https://openrouteservice.org)
# If empty or unset, the application automatically falls back to public OSRM.
ORS_API_KEY=your-ors-api-key-here

# Optional Redis Cache URL (falls back to LocMemCache if unset)
# REDIS_URL=redis://127.0.0.1:6379/1

# Fleet Logistics Parameters
TANK_GALLONS=50
MPG=10
CORRIDOR_MILES=10
ORIGIN_RADIUS_MILES=25
